[Unit]
Description=xytro-lifecycle resource manager (watch hogs -> freeze/prio)
Documentation=https://github.com/xytrolabs/xytro-sched
After=xytro-sched.service
Wants=xytro-sched.service

[Service]
Type=simple
# full phase: can PROPOSE freeze/prio/kill/start. kill/start only EXECUTE after
# the approval dialog or an allow-list entry — approval is fail-closed (no
# display, missing session, or timeout => DENY), so the unattended service can
# never kill without explicit human OK. Each cycle watches 60s, acts on the
# worst hog, then exits; Restart=always makes it continuous.
ExecStart=/usr/bin/python3 /home/raf/Desktop/Linux-Xytro/agent/xytro_lifecycle.py watch --seconds 60 --live --phase full
Restart=always
RestartSec=5
# The agent never runs hot; keep it off the fast lane of its own scheduler.
Nice=10
# Best-effort user-session access so outcome notifications reach the desktop.
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=multi-user.target
