[Unit]
Description=xytro-sched AI CPU scheduler (sched_ext/BPF)
Documentation=https://github.com/xytrolabs/xytro-sched
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/home/raf/Desktop/Linux-Xytro/systemd/xytro-sched-start.sh
Environment=XYTRO_BASE=/home/raf/Desktop/Linux-Xytro
# Hyprland-style config lives in the desktop user's ~/.config/xytro (the
# service runs as root, so ~ would be /root - pin it explicitly).
Environment=XYTRO_CONFIG_DIR=/home/raf/.config/xytro
# Always restart: even a clean exit (e.g. the kernel watchdog disabling us on a
# stall) should bring the scheduler back automatically.
Restart=always
RestartSec=5
# Crash-loop guard: if the scheduler stalls and is disabled repeatedly (kernel
# watchdog), give up after 6 restarts in 5 minutes instead of hammering the
# system forever. The unit then goes to 'failed' and the system runs on stock
# CFS - fix the config and `systemctl reset-failed xytro-sched` to retry.
StartLimitIntervalSec=300
StartLimitBurst=6
# The scheduler must never be OOM-killed silently; stop the unit if it is.
OOMPolicy=stop
# Keep the service alive as long as the kernel scheduler is attached.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
